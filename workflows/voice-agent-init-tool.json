        48
      ]
    },
    {
      "parameters": {
        "jsCode": "const phone = $('Normalize Phone').item.json.phone_number;\n\nconst leads = $json.data || [];\n\nconst lead = leads.sort(\n  (a, b) => new Date(b.Created_Time) - new Date(a.Created_Time)\n)[0] || {};\n\nreturn [{\n  json: {\n    customer_found: true,\n    customer_name: [lead.First_Name, lead.Last_Name].filter(Boolean).join(' ') || null,\n    phone_number: phone,\n    lead_id: lead.id || null,\n    contact_id: null,\n    company_name: lead.Company || null,\n    requested_product: lead.Requested_product || null,\n    city: lead.City || null,\n    lead_comment: lead.Description || null,\n    lead_source: lead.Lead_Source || null,\n    assigned_manager: lead.Owner?.name || null,\n    open_deals: 0,\n    business_hours: 'Пн-Пт 09:00-18:00',\n    system_time: $now\n  }\n}];"
      },
      "id": "ed71ebf3-ccc9-40e3-ab84-ed0e77ec8c76",
