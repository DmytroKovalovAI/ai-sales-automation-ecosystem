    {
      "parameters": {
        "jsCode": "const body = $json.body || $json;\nconst raw = body.phone_number || '';\nconst digits = String(raw).replace(/\\D/g, '');\nlet normalized = digits;\nif (digits.startsWith('380')) normalized = '+' + digits;\nelse if (digits.startsWith('0')) normalized = '+38' + digits;\nelse if (!String(raw).startsWith('+')) normalized = '+' + digits;\nelse normalized = raw;\nreturn [{ json: { phone_number: normalized } }];"
      },
      "id": "be5e745c-171e-4eed-bfb2-3bc08e15a7dd",
      "name": "Normalize Phone",
