{
  "name": "Lead Creation from Website Form & Voice Qualification",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const data = $json.body.data;\n\nconst fields = {};\n\nfor (const item of data.submissions) {\n  fields[item.label] = item.value;\n}\n\nreturn [{\n  json: {\n    First_Name: fields[\"Ім'я\"] ?? \"Клієнт\",\n    Last_Name: fields[\"Прізвище\"] ?? \" \",\n    Phone: fields[\"Телефон\"]?.replace(/\\s+/g, \"\") ?? null,\n    Email: fields[\"Електронна пошта\"] ?? null,\n    Description: fields[\"Ваше повідомлення\"] ?? null,\n    City: fields[\"Місто\"] ?? null,\n    Lead_Source: \"Online Store\",\n    Lead_Status: \"New\",\n    Company: \"-\"\n  }\n}];"
      },
      "id": "4bfa9402-7748-426b-89b0-65cca40b9f85",
      "name": "Map Form Fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ]
    },
    {
      "parameters": {
        "resource": "lead",
        "Company": "={{ $json.Company }}",
        "lastName": "={{ $json.First_Name }}",
        "additionalFields": {
          "Description": "={{ $json.Description }}",
          "Email": "={{ $json.Email }}",
          "Lead_Source": "={{ $json.Lead_Source }}",
          "Lead_Status": "={{ $json.Lead_Status }}",
          "Phone": "={{ $json.Phone }}"
        }
      },
      "type": "n8n-nodes-base.zohoCrm",
      "typeVersion": 1,
      "position": [
        448,
        0
      ],
      "id": "022ee4a1-63c5-4c50-bc5c-44ac66330abd",
      "name": "Create a lead"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "website-lead-form-demo",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "id": "df6f9168-9afc-4e3a-9b49-d9803f908209",
